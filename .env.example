# Supabase Project (Seguro para exponer en el navegador)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Dominio base para los enlaces de QR y NFC
VITE_APP_URL=https://latido-opinion.vercel.app

# Contacto comercial que se muestra en la landing (WhatsApp solo dígitos, con código de país)
VITE_CONTACT_WHATSAPP=5493810000000
VITE_CONTACT_EMAIL=ventas@tu-dominio.com
